fn __poly_pow(base, exp) {
    if exp < 0 {
        return 0;
    }
    var result = 1;
    var b = base;
    var e = exp;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b;
        }
        b = b * b;
        e = e / 2;
    }
    return result;
}
