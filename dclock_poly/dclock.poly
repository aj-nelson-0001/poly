# ============================================================
#  dclock.poly — Digital Clock, rewritten from Rust in Poly
# ============================================================
# A 5x5 bitmap digital clock (HH:MM:SS) rendered into a pixel
# buffer and shown in a resizable window.
#
# The original Rust program used the `minifb` windowing crate
# and `chrono` for wall-clock time. Poly has no foreign crates
# of its own, so the platform layer (window + clock) lives in
# the #rust block below, while ALL of the clock's logic — the
# digit bitmaps, scaling, layout, and pixel drawing — is
# written in Poly and transpiled to Rust.
#
# Build:  poly dclock.poly              (compiles + runs it)
#         poly --project build dclock.poly && cargo run --release
#     or run the prebuilt generated sources in this directory:
#         cargo run --release --manifest-path Cargo.toml

# ------------------------------------------------------------
# Platform layer (Rust foreign helpers: minifb + chrono)
# ------------------------------------------------------------
extern rust fn window_open(title: string, width: i32, height: i32): bool
extern rust fn window_should_close(): bool
extern rust fn window_resize(): Vec<i32>
extern rust fn window_present(pixels: Vec<i32>, width: i32, height: i32): bool
extern rust fn clock_seconds_now(): Vec<i32>

#rust
use chrono::Timelike;
use std::cell::RefCell;
use std::time::{Duration, Instant};

// -- Window state (minifb) --
// Single-threaded GUI loop, so thread-local cells keep this warning-free
// (no `static mut` references).
thread_local! {
    static WINDOW: RefCell<Option<minifb::Window>> = const { RefCell::new(None) };
    static LAST_SIZE: RefCell<Option<(i32, i32)>> = const { RefCell::new(None) };
}

// -- Clock state (chrono) --
thread_local! {
    static CLOCK_LAST_HMS: RefCell<[i32; 3]> = const { RefCell::new([-1, -1, -1]) };
    static CLOCK_LAST_TICK: RefCell<Option<Instant>> = const { RefCell::new(None) };
}

fn window_open(title: String, width: i32, height: i32) -> bool {
    let window = minifb::Window::new(
        &title,
        width as usize,
        height as usize,
        minifb::WindowOptions {
            resize: true,
            ..minifb::WindowOptions::default()
        },
    );
    match window {
        Ok(w) => {
            WINDOW.with(|cell| *cell.borrow_mut() = Some(w));
            true
        }
        Err(_) => false,
    }
}

fn window_should_close() -> bool {
    WINDOW.with(|cell| match cell.borrow().as_ref() {
        Some(w) => !w.is_open() || w.is_key_down(minifb::Key::Escape),
        None => true,
    })
}

// Returns the current size as [width, height]; [-1, -1] when unchanged.
fn window_resize() -> Vec<i32> {
    WINDOW.with(|cell| match cell.borrow().as_ref() {
        Some(w) => {
            let (w, h) = w.get_size();
            let (pw, ph) = (w as i32, h as i32);
            let unchanged = LAST_SIZE.with(|c| match *c.borrow() {
                Some((lw, lh)) => lw == pw && lh == ph,
                None => false,
            });
            if unchanged {
                [-1, -1].to_vec()
            } else {
                LAST_SIZE.with(|c| *c.borrow_mut() = Some((pw, ph)));
                [pw, ph].to_vec()
            }
        }
        None => [-1, -1].to_vec(),
    })
}

fn window_present(pixels: Vec<i32>, width: i32, height: i32) -> bool {
    let frame: Vec<u32> = pixels.iter().map(|p| *p as u32).collect();
    WINDOW.with(|cell| match cell.borrow_mut().as_mut() {
        Some(w) => w
            .update_with_buffer(&frame, width as usize, height as usize)
            .is_ok(),
        None => false,
    })
}

// Returns the current local time as [hour, minute, second],
// refreshed at most once per second.
fn clock_seconds_now() -> Vec<i32> {
    let fresh = CLOCK_LAST_TICK.with(|c| match *c.borrow() {
        Some(t) => t.elapsed() >= Duration::from_secs(1),
        None => true,
    });
    if !fresh {
        return CLOCK_LAST_HMS.with(|c| c.borrow().to_vec());
    }
    let now = chrono::Local::now();
    let hms = [now.hour() as i32, now.minute() as i32, now.second() as i32];
    CLOCK_LAST_HMS.with(|c| *c.borrow_mut() = hms);
    CLOCK_LAST_TICK.with(|c| *c.borrow_mut() = Some(Instant::now()));
    hms.to_vec()
}
#endrust

# ------------------------------------------------------------
# Clock display constants
# ------------------------------------------------------------
const DIGIT_WIDTH := 5
const DIGIT_HEIGHT := 5
const INITIAL_WIDTH := 450
const INITIAL_HEIGHT := 100

const BACKGROUND := 0x000000
const FOREGROUND := 0xFFFFFF
const COLON_COLOR := 0xFFFF00

# Bitmap representations of digits 0-9, row-major, 25 bits
fn digit_bits(digit: i32): i32
    match digit
        0, return 0b1111110001100011000111111
        1, return 0b0010001100001000010001110
        2, return 0b1111100001111111000011111
        3, return 0b1111100001111110000111111
        4, return 0b1000110001111110000100001
        5, return 0b1111110000111110000111111
        6, return 0b1111110000111111000111111
        7, return 0b1111100001000100010001000
        8, return 0b1111110001111111000111111
        _, return 0b1111110001111110000111111
    end match
end fn

# ------------------------------------------------------------
# Digit rendering: scale a 5x5 bitmap into a pixel buffer
# ------------------------------------------------------------
struct DigitBuffer
    buffer: Vec<i32>
    width: i32
    height: i32
end struct

# Build a scaled pixel buffer for one digit (0-9)
fn make_digit(digit: i32, scale_x: i32, scale_y: i32): DigitBuffer
    var width i32 := DIGIT_WIDTH * scale_x
    var height i32 := DIGIT_HEIGHT * scale_y
    var total i32 := width * height
    var buffer Vec<i32> := []
    loop i 0..total - 1
        buffer.push(BACKGROUND)
    end loop

    var bits i32 := digit_bits(digit)
    loop y 0..DIGIT_HEIGHT - 1
        loop x 0..DIGIT_WIDTH - 1
            var bit_index i32 := DIGIT_WIDTH * DIGIT_HEIGHT - 1 - (y * DIGIT_WIDTH + x)
            if (bits >> bit_index) bitand 1 = 1,
                loop dy 0..scale_y - 1
                    loop dx 0..scale_x - 1
                        var index i32 := (y * scale_y + dy) * width + (x * scale_x + dx)
                        buffer[index] := FOREGROUND
                    end loop
                end loop
            end if
        end loop
    end loop

    return DigitBuffer { buffer: buffer, width: width, height: height }
end fn

# Scaled pixel buffers for all ten digits
fn create_digit_buffers(scale_x: i32, scale_y: i32): Vec<DigitBuffer>
    var buffers Vec<DigitBuffer> := []
    loop d 0..9
        buffers.push(make_digit(d, scale_x, scale_y))
    end loop
    return buffers
end fn

# ------------------------------------------------------------
# Drawing
# ------------------------------------------------------------

# Draw the two dots of the colon separator, vertically centered
fn draw_colon(buffer: Vec<i32>, width: i32, height: i32, x: i32, colon_width: i32): Vec<i32>
    var out Vec<i32> := buffer
    var colon_height i32 := height / 6
    var gap i32 := height / 20
    var total_colon_height i32 := 2 * colon_height + gap
    var start_y i32 := (height - total_colon_height) / 2

    var bottom_y i32 := start_y + colon_height + gap
    loop dy 0..colon_height - 1
        loop dx 0..colon_width - 1
            if start_y + dy < height and x + dx < width,
                var index i32 := (start_y + dy) * width + (x + dx)
                out[index] := COLON_COLOR
            end if
            if bottom_y + dy < height and x + dx < width,
                var index i32 := (bottom_y + dy) * width + (x + dx)
                out[index] := COLON_COLOR
            end if
        end loop
    end loop
    return out
end fn

# Expand [hour, minute, second] into the six display digits
# [H, H, M, M, S, S]
fn expand_time(hms: Vec<i32>): Vec<i32>
    var digits Vec<i32> := []
    loop i 0..2
        var value i32 := hms[i]
        digits.push(value / 10)
        digits.push(value mod 10)
    end loop
    return digits
end fn

# Lay out and draw "HH:MM:SS" centered in the buffer
fn draw_time(digit_buffers: Vec<DigitBuffer>, buffer: Vec<i32>, time: Vec<i32>, width: i32, height: i32): Vec<i32>
    var out Vec<i32> := buffer
    var digit_width i32 := digit_buffers[0].width
    var digit_height i32 := digit_buffers[0].height
    var spacing i32 := digit_width / 4
    var colon_width i32 := digit_width / 4
    var total_width i32 := 6 * digit_width + 2 * colon_width + 5 * spacing
    var start_x i32 := 0
    if width > total_width,
        start_x := (width - total_width) / 2
    end if
    var start_y i32 := (height - digit_height) / 2

    var x i32 := start_x
    loop i 0..5
        var digit i32 := time[i]

        # Copy this digit's scaled pixels into the frame buffer
        if x + digit_width <= width,
            var src_width i32 := digit_buffers[digit].width
            var src_height i32 := digit_buffers[digit].height
            var copy_width i32 := digit_width
            if width - x < copy_width,
                copy_width := width - x
            end if
            loop y 0..src_height - 1
                var target_y i32 := start_y + y
                if target_y >= 0 and target_y < height,
                    loop dx 0..copy_width - 1
                        var src_index i32 := y * src_width + dx
                        var dst_index i32 := target_y * width + x + dx
                        out[dst_index] := digit_buffers[digit].buffer[src_index]
                    end loop
                end if
            end loop
        end if
        x := x + digit_width + spacing

        # Draw colon after the hours (HH:) and the minutes (MM:)
        if i = 1 or i = 3,
            if x + colon_width <= width,
                out := draw_colon(out, width, height, x, colon_width)
            end if
            x := x + colon_width + spacing
        end if
    end loop
    return out
end fn

# Build a complete frame: background, scaled digits, and the time.
# Scaling is recomputed per frame so window resizes are picked up.
fn render_clock(time: Vec<i32>, width: i32, height: i32): Vec<i32>
    var buffer Vec<i32> := []
    loop i 0..width * height
        buffer.push(BACKGROUND)
    end loop

    var scale_x i32 := width / 50
    if scale_x < 1,
        scale_x := 1
    end if
    var scale_y i32 := height / 5
    if scale_y < 1,
        scale_y := 1
    end if

    var digit_buffers Vec<DigitBuffer> := create_digit_buffers(scale_x, scale_y)
    return draw_time(digit_buffers, buffer, expand_time(time), width, height)
end fn

# ------------------------------------------------------------
# Main loop
# ------------------------------------------------------------
fn main()
    var width i32 := INITIAL_WIDTH
    var height i32 := INITIAL_HEIGHT

    if not window_open("Digital Clock", width, height),
        error "could not open window"
    end if

    var buffer Vec<i32> := []

    # Runs until the window closes or Escape is pressed.
    # clock_seconds_now() refreshes at most once per second, so the
    # per-frame rebuild below is cheap in practice.
    loop
        if window_should_close(),
            break
        end if

        # Handle window resizing
        var size Vec<i32> := window_resize()
        if size[0] > 0,
            width := size[0]
            height := size[1]
        end if

        var time Vec<i32> := clock_seconds_now()
        buffer := render_clock(time, width, height)

        if not window_present(buffer, width, height),
            break
        end if
    end loop
end fn
