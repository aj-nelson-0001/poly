# =============================================================================
# Async/Await Example
# =============================================================================
#
# `async fn` marks a function as suspendable; calling it returns a future
# that does nothing until you attach `.await`, which suspends the caller
# until the future completes. Only async functions can use `.await`.
#
# Under the Rust target this lowers to tokio's async runtime; the `main`
# future is polled to completion before the process exits. The pipeline
# here is fetch -> process -> print, with each stage awaiting the previous.

# Simulates an HTTP fetch: logs the URL, returns a fake payload.
async fn fetch_data(url: ustring): ustring
    put unicode "Fetching data from: " + url
    return unicode "response data"
end fn

# Async function to simulate processing
async fn process_data(data: ustring): ustring
    put unicode "Processing: " + data
    return unicode "processed " + data
end fn

# Regular function that uses async
async fn get_user_info(): ustring
    var data := fetch_data(unicode "https://api.example.com/user").await
    var result := process_data(data).await
    return result
end fn


# Main function
async fn main()
    put unicode "=== Async/Await Demo ==="

    # Call async function
    var result := get_user_info().await
    put result
end fn
