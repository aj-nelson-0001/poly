# =============================================================================
# Async/Await Example
# =============================================================================

# Async function to simulate fetching data
async fn fetch_data(url: ustring): ustring
    put unicode "Fetching data from: " + url
    return unicode "response data"
end fn

# Async function to simulate processing
async fn process_data(data: ustring): ustring
    put unicode "Processing: " + data
    return unicode "processed " + data
end fn

# Regular function that uses async
async fn get_user_info(): ustring
    var data := fetch_data(unicode "https://api.example.com/user").await
    var result := process_data(data).await
    return result
end fn


# Main function
async fn main()
    put unicode "=== Async/Await Demo ==="
    
    # Call async function
    var result := get_user_info().await
    put result
end fn
