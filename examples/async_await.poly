# =============================================================================
# Async/Await Example
# =============================================================================

# Async function to simulate fetching data
async fn fetch_data(url: ustring): ustring
    put u"Fetching data from: " + url
    return u"response data"
end fn

# Async function to simulate processing
async fn process_data(data: ustring): ustring
    put u"Processing: " + data
    return u"processed " + data
end fn

# Regular function that uses async
fn get_user_info(): ustring
    var data = fetch_data(u"https://api.example.com/user").await
    var result = process_data(data).await
    return result
end fn

# Main function
fn main()
    put u"=== Async/Await Demo ==="
    
    # Call async function
    var result = get_user_info()
    put result
end fn
