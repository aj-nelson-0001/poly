# =============================================================================
# Async Patterns Examples
# =============================================================================

# =============================================================================
# 1. Basic Async/Await
# =============================================================================

async fn simple_async(): ustring
    put unicode "Starting async operation..."
    var result := delay(100).await
    put unicode "Operation complete!"
    return unicode "Result: " + result
end fn

# =============================================================================
# 2. Async with Error Handling
# =============================================================================

async fn fetch_with_retry(url: ustring, max_retries: i32): Result<ustring, ustring>
    var attempt i32 := 0
    
    while attempt < max_retries
        add attempt
        put unicode "Attempt " + attempt.to_string() + unicode "..."
        
        match http_get(url).await
            Ok(data) => return Ok(data)
            Error(e) => 
                if attempt < max_retries,
                    put unicode "Failed, retrying..."
                    delay(1000).await
                end if
        end match
    end while
    
    return Error(unicode "Max retries exceeded")
end fn

# =============================================================================
# 3. Async Struct Methods
# =============================================================================

struct Database
    var connection_string: ustring
    var connected: bool
end struct

impl Database
    async fn connect(self): Result<ustring, ustring>
        put unicode "Connecting to database..."
        var conn := tcp_connect(self.connection_string).await
        set self.connected to true
        return Ok(unicode "Connected!")
    end fn
    
    async fn query(self, sql: ustring): Result<Vec<ustring>, ustring>
        if !self.connected,
            return Error(unicode "Not connected")
        end if
        
        put unicode "Executing query: " + sql
        var results := db_execute(sql).await
        return Ok(results)
    end fn
    
    async fn close(self)
        if self.connected,
            put unicode "Closing connection..."
            set self.connected to false
        end if
    end fn
end impl

# =============================================================================
# 4. Async with Match Expressions
# =============================================================================

async fn process_response(url: ustring): ustring
    match http_get(url).await
        Ok(data) =>
            if data.len() > 0,
                return unicode "Got data: " + data
            else
                return unicode "Empty response"
            end if
        Error(TimeoutError) =>
            warn unicode "Request timed out"
            return unicode "Timeout"
        Error(NotFoundError) =>
            error unicode "Resource not found"
            return unicode "Not found"
        Error(e) =>
            error e
            return unicode "Unknown error"
    end match
end fn

