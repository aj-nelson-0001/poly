# Poly Example: Higher-Order Functions
#
# Functions are values: accept closures through function-typed parameters,
# return closures that capture locals, and transform vectors with
# map/filter/reduce.
#
# Closure syntax:
#   - `|x: i32| i32` is a function *type*: parameter types are optional
#     where they can be inferred, so `|x| x + n` is also legal.
#   - A closure captures surrounding variables by reference to the
#     enclosing frame (`n` in `make_adder` lives as long as the returned
#     closure needs it).
#
# Vector combinators (methods on `[T]`):
#   - `map(f)`     — new vector with f applied to each element.
#   - `filter(p)`  — new vector of elements where p(x) is true.
#   - `reduce(acc, f)` — left fold; `reduce(0, |acc, x| acc + x)` sums.
#   - `sort_by(cmp)`   — in-place-style sort with a "greater than" comparator.

# Applies f to v. The parameter type shows the full closure-type syntax.
fn apply(f: |x: i32| i32, v: i32): i32
    return f(v)
end fn

# Returns a closure that captures `n`. Each call to make_adder yields an
# independent adder with its own captured n.
fn make_adder(n: i32): |x: i32| i32
    return |x| x + n
end fn

fn main()
    put "apply(|x| x * 2, 21):"
    put apply(|x| x * 2, 21)          # 42
    put "apply(|x| x + 1, 41):"
    put apply(|x| x + 1, 41)          # 42

    var add5 := make_adder(5)
    put "add5(10):"
    put add5(10)                      # 15
    put "make_adder(100)(1):"
    put make_adder(100)(1)            # 101 — call the returned closure directly

    var xs := [1, 2, 3, 4, 5]
    put "doubled (first and last):"
    put xs.map(|x| x * 2)[0]          # 2
    put xs.map(|x| x * 2)[4]          # 10
    put "evens:"
    var evens := xs.filter(|x| x mod 2 = 0)
    for v in evens
        put v                         # 2 4
    end for
    put "sum:"
    put xs.reduce(0, |acc, x| acc + x)   # 15
    put "product:"
    put xs.reduce(1, |acc, x| acc * x)   # 120
    put "sorted (descending):"
    put xs.sort_by(|a, b| a > b)         # [5, 4, 3, 2, 1]
    put "string chars:"
    put "hello".map(|c| c)               # maps over characters
end fn
