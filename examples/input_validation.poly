# Poly Example: Input Validation and Timeout
# Demonstrates advanced input features with the new syntax

fn main()
    put "=== Input Validation Demo ==="
    put ""
    
    # Test 1: Age validation
    put "Test 1: Age validation"
    var age: i32 = get with validate |x| x >= 1 && x <= 150
    put "Valid age: " + age.to_string()
    put ""
    
    # Test 2: Email validation (using a helper function)
    put "Test 2: Email validation"
    var email: ustring = get with validate |e| is_valid_email(e)
    put "Valid email: " + email
    put ""
    
    # Test 3: Default values
    put "Test 3: Default values"
    var name: ustring = get --default u"Anonymous"
    put "Name: " + name
    put ""
    
    # Test 4: Timeout test
    put "Test 4: Timeout (3 seconds to respond)"
    match get --timeout 3000
        Ok(input) => put "You typed: " + input
        Timeout => warn "Too slow! Timeout occurred."
        Error(e) => error "Error: " + e
    end match
    put ""
    
    # Test 5: Delimiter-based input
    put "Test 5: CSV parsing"
    put -n "Enter CSV line (e.g., Alice,30,alice@email.com): "
    var csv_line: ustring = get --until u","
    put "First field: " + csv_line
    put ""
    
    # Test 6: Password with validation
    put "Test 6: Password with validation"
    var password: ustring = get --mask u"*" with validate |p| p.len() >= 8
    put "Password accepted (length: " + password.len().to_string() + ")"
    put ""
    
    # Test 7: Type conversion (--as flag)
    put "Test 7: Type conversion"
    put -n "Enter a number: "
    var num: i32 = get --as i32
    put "You entered: " + num.to_string()
    put "Doubled: " + (num * 2).to_string()
    put ""
    
    # Test 8: Read specific number of bytes (--bytes flag)
    put "Test 8: Read specific bytes"
    put "Creating test file..."
    put "Hello, World!" > "test_bytes.txt"
    put "Reading first 5 bytes..."
    var first_five: bytes = get < "test_bytes.txt" --bytes 5
    put "First 5 bytes: " + first_five.len().to_string() + " bytes"
    put ""
    
    put "All tests completed!"
end fn

# Helper function to validate email
fn is_valid_email(email: ustring): bool
    # Simple email validation
    if email.len() < 5 then
        return false
    end if
    
    # Check for @ symbol
    var has_at: bool = false
    loop: 0..email.len()
        if email[i] == u'@' then
            has_at = true
            break
        end if
    end loop
    
    if not has_at then
        return false
    end if
    
    # Check for . after @
    var has_dot: bool = false
    var after_at: bool = false
    loop: 0..email.len()
        if email[i] == u'@' then
            after_at = true
        else if after_at && email[i] == u'.' then
            has_dot = true
        end if
    end loop
    
    return has_dot
end fn
