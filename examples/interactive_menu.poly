# Poly Example: Interactive Menu
# Demonstrates the new I/O syntax with flags

fn main()
    put "=== Interactive Menu Demo ==="
    put ""
    
    var running bool := true
    while running
        put "Menu:"
        put "1. Greet user"
        put "2. Calculator"
        put "3. Password test"
        put "4. Exit"
        put ""
        put -n "Choose an option (1-4): "
        
        var choice i32 := get
        
        match choice
            1, greet_user()
            2, calculator()
            3, password_test()
            4,
                put "Goodbye!"
                set running to false
            _, warn "Invalid choice. Please try again."
        end match
        
        put ""
    end while
end fn

fn greet_user()
    put -n "Enter your name: "
    var name ustring := get --default unicode "World"
    put "Hello, " + name + "!"
end fn

fn calculator()
    put -n "Enter first number: "
    var a f64 := get
    
    put -n "Enter second number: "
    var b f64 := get
    
    put -n "Choose operation (+, -, *, /): "
    var op ustring := get --default unicode "+"
    
    var result f64 := match op
        unicode "+", a + b
        unicode "-", a - b
        unicode "*", a * b
        unicode "/",
            if b = 0.0,
                error "Error: Division by zero"
                0.0
            else
                a / b
            end if
        _,
            warn "Unknown operation, using +"
            a + b
    end match
    
    put "Result: " + result.to_string()
end fn

fn password_test()
    put "Enter password (masked): "
    var password ustring := get --mask unicode "*"
    
    put "Password length: " + password.len().to_string()
    
    if password.len() < 8,
        warn "Password too short (minimum 8 characters)"
    else
        put "Password accepted"
    end if
end fn
