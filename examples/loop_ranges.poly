# Poly Example: Loop Ranges (Sinclair QL SuperBASIC-inspired)
# This program demonstrates the new loop ranges syntax with multiple ranges,
# steps, and collection iteration.

fn main()
    put "=== Loop Ranges Demo ==="
    put ""
    
    # Test 1: Simple range
    put "Test 1: Simple range (0..5)"
    loop i 0..5
        put "  " + i.to_string()
    end loop
    put ""
    
    # Test 2: Multiple ranges and specific values
    put "Test 3: Multiple ranges and values (1..3, 7, 19..21)"
    loop i 1..3, 7, 19..21
        put "  " + i.to_string()
    end loop
    put ""
    
    # Test 4: Step with positive increment
    put "Test 4: Step (0..10 step 2)"
    loop i 0..10 step 2
        put "  " + i.to_string()
    end loop
    put ""
    
    # Test 5: Negative step (counting down)
    put "Test 5: Negative step (10..1 step -1)"
    loop i 10..1 step -1
        put "  " + i.to_string()
    end loop
    put ""
    
    # Test 6: Mixed ranges with steps
    put "Test 6: Mixed ranges with steps (0..10 step 3, 20..30 step 5)"
    loop i 0..10 step 3, 20..30 step 5
        put "  " + i.to_string()
    end loop
    put ""
    
    # Test 7: Specific values only
    put "Test 7: Specific values (1, 5, 10, 100)"
    loop i 1, 5, 10, 100
        put "  " + i.to_string()
    end loop
    put ""
    
    # Test 8: Complex mix
    put "Test 8: Complex mix (1..5, 10, 20..25 step 2, 100)"
    loop i 1..5, 10, 20..25 step 2, 100
        put "  " + i.to_string()
    end loop
    put ""
    
    # Test 9: Iterate over collection
    put "Test 9: Iterate over collection"
    var fruits Vec<ustring> := [unicode "apple", unicode "banana", unicode "cherry", unicode "date"]
    loop fruit in fruits
        put "  " + fruit
    end loop
    put ""
    
    # Test 10: Iterate with index
    put "Test 10: Iterate with index"
    loop (index, fruit) in fruits.enumerate()
        put "  " + index.to_string() + ": " + fruit
    end loop
    put ""
    
    # Test 11: Practical example - Multiplication table
    put "Test 11: Multiplication table (1..5 x 1..5)"
    put "    |  1   2   3   4   5"
    put "----+-------------------"
    loop i 1..5
        var row ustring := " " + i.to_string() + " | "
        loop j 1..5
            var product i32 := i * j
            var next_row := row + product.to_string().pad_left(3) + " "
            row := next_row
        end loop
        put row
    end loop
    put ""
    
    # Test 12: Practical example - Prime numbers check
    put "Test 12: Prime numbers from 1 to 30"
    put "  Primes: "
    loop i 2..30
        if is_prime(i),
            put i.to_string() + " "
        end if
    end loop
    put ""
    put ""
    
    put "=== Loop Ranges Demo Complete ==="
end fn

# Helper function to check if a number is prime
fn is_prime(n: i32): bool
    if n <= 1,
        return false
    end if
    loop i 2..n-1
        if n % i = 0,
            return false
        end if
    end loop
    return true
end fn
