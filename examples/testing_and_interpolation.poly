# Poly Example: String Interpolation, Checked Indexing & Testing
#
# Interpolate expressions directly into strings with {expr}, index vectors
# and strings safely with .get(i), and check your logic with the
# assert/pass/fail test helpers.

fn grade_label(score: i32): string
    if score >= 90,
        return "A"
    else if score >= 80,
        return "B"
    else if score >= 70,
        return "C"
    else
        return "F"
    end if
end fn

fn main()
    # --- String interpolation ---
    var name := "Ada"
    var age := 36
    var score := 87.5
    put "Hello, {name}! You are {age} and scored {score}."
    put unicode "{name} (age {age}) passes: {score >= 60.0}."
    put "Grade: {grade_label(score as i32)}"

    # --- Checked indexing ---
    var xs := [10, 20, 30]
    put "xs.get(1):"
    put xs.get(1)
    put "xs.get(99) (None expected):"
    put xs.get(99)
    put "text.get(0):"
    put "hello".get(0)
    put "text.get(9) (None expected):"
    put "hello".get(9)

    # --- Test helpers ---
    assert(name != "")
    pass("name is non-empty")
    assert(age >= 18)
    pass("age is adult")
    assert(score >= 0.0)
    pass("score is non-negative")

    match xs.get(2)
        Some(v), pass("checked indexing works")
        None, fail("expected a value at index 2")
    end match

    match xs.get(99)
        Some(v), fail("index 99 should be out of bounds")
        None, pass("out-of-bounds get returns None")
    end match

    put "All tests passed!"
end fn
