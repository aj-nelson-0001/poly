# =============================================================================
# Trait & Async/Await Demo
# =============================================================================

# Basic trait
trait Greetable
    fn greet(self): ustring
end trait

# Struct
struct Person
    var name: ustring
    var age: i32
end struct

# Implement trait
impl Greetable for Person
    fn greet(self): ustring
        return unicode "Hello, I'm " + self.name
    end fn
end impl

# Async trait
trait DataFetcher
    async fn fetch(self, url: ustring): Result<ustring, ustring>
end trait

# Struct with async trait
struct HttpClient
    var base_url: ustring
end struct

impl DataFetcher for HttpClient
    async fn fetch(self, url: ustring): Result<ustring, ustring>
        put unicode "Fetching: " + self.base_url + url
        var response := http_get(self.base_url + url).await
        return response
    end fn
end impl

# Main
fn main()
    put unicode "=== Trait & Async Demo ==="
    
    var person := Person { name: unicode "Alice", age: 30 }
    put person.greet()
    
    var client := HttpClient { base_url: unicode "https://api.example.com" }
    # var result = client.fetch(unicode "/users").await
    
    put unicode "=== Done ==="
end fn
