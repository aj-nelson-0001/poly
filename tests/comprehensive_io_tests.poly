# Poly Comprehensive I/O Tests
# Tests for the new I/O syntax with flags and error/warning commands

# ============================================================
# OUTPUT TESTS
# ============================================================

# Test 1: Basic Output
put "=== Test 1: Basic Output ==="
put "Hello, World!"
put 42
put 3.14159
put true

# Test 2: Output without newline (-n flag)
put "\n=== Test 2: Output Without Newline (-n flag) ==="
put "Loading"
put "."
put "."
put "."
put "Done!"

# Test 3: Error/Warning/Info commands
put "\n=== Test 3: Error/Warning/Info Commands ==="
error "This is an error message"
warn "This is a warning message"
info "This is debug info"

# Test 4: Output formatting
put "\n=== Test 4: Output Formatting ==="
var name ustring := unicode "Poly"
var version i32 := 1
put "Language: {name}, Version: {version}"
put "Pi: {3.14159:.2f}"

# Test 5: File output
put "\n=== Test 5: File Output ==="
put "Writing to test_output.txt..."
put "Line 1\nLine 2\nLine 3" to "test_output.txt"
put "Appending to test_output.txt..."
put "Line 4" to "test_output.txt" -append
put "Done."

# ============================================================
# INPUT TESTS
# ============================================================

# Test 6: Basic Input
put "\n=== Test 6: Basic Input ==="
put "Enter your name: "
var name_input ustring := get
put "Hello, " + name_input + "!"

# Test 7: Typed Input
put "\n=== Test 7: Typed Input ==="
put "Enter your age: "
var age i32 := get
put "In 10 years you will be: " + (age + 10)

# Test 8: Input with default value (--default flag)
put "\n=== Test 8: Input with Default Value ==="
put "Enter color (or press Enter for default): "
var color ustring := get --default unicode "blue"
put "Color: " + color

# Test 9: Input with mask (--mask flag)
put "\n=== Test 9: Input with Mask ==="
put "Enter password (masked): "
var password ustring := get --mask unicode "*"
put "Password length: " + password.len()

# Test 10: Input with timeout (--timeout flag)
put "\n=== Test 10: Input with Timeout ==="
put "Quick! Type something within 3 seconds: "
match get --timeout 3000
    Ok(input), put "You typed: " + input
    Timeout, warn "Too slow!"
    Error(e), error "Error: " + e
end match

# Test 11: Input with validation
put "\n=== Test 11: Input with Validation ==="
put "Enter a number between 1 and 100: "
var validated i32 := get with validate |x| x >= 1 && x <= 100
put "You entered: " + validated

# Test 12: Input with delimiter (--until flag)
put "\n=== Test 12: Input with Delimiter ==="
put "Enter CSV line (comma-separated): "
var csv_line ustring := get --until unicode ","
put "First field: " + csv_line

# Test 13: Type conversion (--as flag)
put "\n=== Test 13: Type Conversion ==="
put "Enter a number: "
var num i32 := get --as i32
put "You entered: " + num.to_string()
put "Doubled: " + (num * 2).to_string()

# Test 14: File input
put "\n=== Test 14: File Input ==="
put "Reading from test_output.txt..."
var file_content ustring := get from "test_output.txt"
put "File content:\n" + file_content

# Test 15: Binary file input
put "\n=== Test 15: Binary File Input ==="
put "Reading binary from test_output.txt..."
var binary_data bytes := get from "test_output.txt"
put "Binary size: " + binary_data.len() + " bytes"

# Test 16: Input with bytes flag (--bytes flag)
put "\n=== Test 16: Input with Bytes Flag ==="
put "Creating test file..."
put "Hello, World!" to "test_bytes.txt"
put "Reading first 5 bytes..."
var first_five bytes := get from "test_bytes.txt" --bytes 5
put "First 5 bytes: " + first_five.len() + " bytes"

# Test 17: Completion
put "\n=== Test 17: Completion ==="
put "Choose a command (start/stop/pause): "
var command ustring := get with complete [unicode "start", unicode "stop", unicode "pause"]
put "You chose: " + command

# Test 18: Structured input
put "\n=== Test 18: Structured Input ==="
put "Enter person as 'name,age' (e.g., Alice,30): "
var input ustring := get
var parts := input.split(unicode ",")
put "Name: " + parts[0] + ", Age: " + parts[1]

# Test 19: Input loop
put "\n=== Test 19: Input Loop ==="
put "Enter numbers (type 'quit' to exit):"
var inputs Vec<ustring> := []
loop
    var input ustring := get
    if input = unicode "quit",
        break
    end if
    put "Stored: " + input
    inputs.push(input)
end loop
put "You entered " + inputs.len() + " numbers."

# Test 20: Error recovery
put "\n=== Test 20: Error Recovery ==="
loop
    put "Enter a positive number: "
    var num i32 := get --as i32
    if num > 0,
        put "You entered: " + num.to_string()
        break
    else
        warn "Please enter a positive number"
    end if
end loop

# ============================================================
# COMBINED TESTS
# ============================================================

# Test 21: Combined flags
put "\n=== Test 21: Combined Flags ==="
put "Enter a number (will timeout in 5 seconds): "
match get --timeout 5000 --default unicode "0"
    Ok(input), put "You entered: " + input
    Timeout, warn "Timeout, using default"
    Error(e), error "Error: " + e
end match

# Test 22: Multiple outputs with different flags
put "\n=== Test 22: Multiple Outputs with Flags ==="
put "Normal output"
put "No newline output"
put " (this continues on same line)"
error "Error output"
warn "Warning output"
info "Debug output"

# Test 23: File operations with flags
put "\n=== Test 23: File Operations with Flags ==="
put "Creating file..."
put "Line 1" to "test_flags.txt"
put "Line 2" to "test_flags.txt" -append
put "Reading file..."
var content ustring := get from "test_flags.txt"
put "Content:\n" + content

# Test 24: Complex input scenario
put "\n=== Test 24: Complex Input Scenario ==="
put "This test demonstrates multiple input features combined"
put "Enter your name (default: Anonymous): "
var user_name ustring := get --default unicode "Anonymous"
put "Enter your age: "
var user_age i32 := get with validate |x| x > 0 && x < 150
put "Enter your email: "
var user_email ustring := get with validate |e| e.contains(unicode "@")

put "\nUser Information:"
put "Name: " + user_name
put "Age: " + user_age
put "Email: " + user_email

put "\n=== All Tests Complete ==="
