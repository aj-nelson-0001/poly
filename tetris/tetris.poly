# =====================================================================
# Tetris — written in Poly, compiled to native Rust
# =====================================================================
# A faithful port of the original JS Tetris (ghost piece, hold, 5-piece
# next queue, NES-style gravity/scoring, synthesized audio, high score).
#
# Architecture notes (Poly semantics):
#   - Vec/struct values MOVE. Methods take `self` by value and must
#     `return self`; callers rebind: `s := s.method(..)`.
#   - Query results are stashed in q_* fields (i32 is Copy) so main can
#     read state without moving it.
#   - The render framebuffer is rebuilt each frame; render_frame takes
#     the state and returns (state, fb) as a tuple.
#   - `--test` runs a headless logic self-test instead of the GUI.
#
# Build:  poly --project gen tetris.poly && (cd gen && cargo run --release)
#         cargo run --release -- --test   (headless self-test)
# =====================================================================

# ------------------------------------------------------------
# Platform layer externs (implemented in the #rust block below)
# ------------------------------------------------------------
extern rust fn now_ms(): i64
extern rust fn highscore_load(): i32
extern rust fn highscore_save(v: i32)
extern rust fn audio_init()
extern rust fn audio_play(kind: i32)
extern rust fn rng_seed(): u64
extern rust fn win_open(width: i32, height: i32, title: string): bool
extern rust fn win_alive(): bool
extern rust fn win_keys(): Vec<i32>
extern rust fn win_present(pixels: Vec<i32>, width: i32, height: i32): bool
extern rust fn win_close()
extern rust fn get_args(): Vec<string>

# ------------------------------------------------------------
# Constants
# ------------------------------------------------------------
const COLS := 10
const ROWS := 20
const BUF := 2
const TOTAL := 22
const CELL := 30
const PREV := 20
const DAS_DELAY := 170
const DAS_RATE := 35
const FADE := 180
const WINW := 660
const WINH := 732

# board geometry: 300x600 playfield centered between two side panels
const BX := 180
const BY := 66
const BW := 300
const BH := 600
const PW := 100
const PX0 := 62
const PX1 := 498

# palette (mirrors the original page: css vars + JS COLORS)
const BG := 0x05010A
const GRIDBG := 0x000814
const GRIDLN := 0x26204A
const PANELB := 0x2A1C63
const FLASH := 0x888888
const WHITE := 0xFFFFFF
const DIM := 0x8A8A8A
const RED := 0xFF3A4A
const CYNE := 0x2BF2FF
const YELLOW := 0xFFE74A

# ------------------------------------------------------------
# Piece bitmaps: 4x4 footprint, bit (r*4+c) set where a cell exists.
# Indexed by kind*4 + rotation (0 = spawn, clockwise).
# ------------------------------------------------------------
fn shape_bits(kr: i32): i32
    match kr
        0, return 15
        1, return 4369
        2, return 15
        3, return 4369
        4, return 51
        5, return 51
        6, return 51
        7, return 51
        8, return 114
        9, return 305
        10, return 39
        11, return 562
        12, return 54
        13, return 561
        14, return 54
        15, return 561
        16, return 99
        17, return 306
        18, return 99
        19, return 306
        20, return 113
        21, return 275
        22, return 71
        23, return 802
        24, return 116
        25, return 785
        26, return 23
        _, return 547
    end match
end fn

fn bit_at(bits: i32, r: i32, c: i32): bool
    return ((bits shift right (r * 4 + c)) bitand 1) = 1
end fn

fn piece_w(bits: i32): i32
    var w i32 := 0
    loop r 0..3
        loop c 0..3
            if bit_at(bits, r, c),
                if c + 1 > w,
                    w := c + 1
                end if
            end if
        end loop
    end loop
    return w
end fn

fn piece_h(bits: i32): i32
    var h i32 := 0
    loop r 0..3
        loop c 0..3
            if bit_at(bits, r, c),
                if r + 1 > h,
                    h := r + 1
                end if
            end if
        end loop
    end loop
    return h
end fn

# ------------------------------------------------------------
# Colors per piece kind (0=I .. 6=L), matching the original palette
# ------------------------------------------------------------
fn color_of(t: i32): i32
    match t
        0, return 0x2BF2FF
        1, return 0xFFE74A
        2, return 0xC54BFF
        3, return 0x66FF6A
        4, return 0xFF3A4A
        5, return 0x4A7BFF
        _, return 0xFF9A3A
    end match
end fn

# ------------------------------------------------------------
# NES-style gravity: frames per cell at 60fps -> milliseconds
# ------------------------------------------------------------
fn gravity_ms(level: i32): i64
    var lv i32 := level
    if lv > 29,
        lv := 29
    end if
    var f i32 := 1
    match lv
        0, f := 48
        1, f := 43
        2, f := 38
        3, f := 33
        4, f := 28
        5, f := 23
        6, f := 18
        7, f := 13
        8, f := 8
        9, f := 6
        10, f := 5
        11, f := 5
        12, f := 5
        13, f := 4
        14, f := 4
        15, f := 4
        16, f := 3
        17, f := 3
        18, f := 3
        29, f := 1
        _, f := 2
    end match
    return (f as i64 * 1000) / 60
end fn

# ------------------------------------------------------------
# 5x7 bitmap font: bit (y*5+x) of the u64, rows top to bottom
# ------------------------------------------------------------
fn glyph(ch: i32): u64
    match ch
        48, return 15623448110
        49, return 15170932932
        50, return 33357578798
        51, return 15619854623
        52, return 8891181448
        53, return 15620127807
        54, return 15621129292
        55, return 2216829471
        56, return 15621113390
        57, return 6728664622
        65, return 18842895918
        66, return 16694887983
        67, return 15603893806
        68, return 7836583207
        69, return 33321092159
        70, return 1108837439
        71, return 32801457710
        72, return 18842895921
        73, return 15170932878
        74, return 6753100060
        75, return 18560947505
        76, return 33320633377
        77, return 18842572657
        78, return 18842703473
        79, return 15621211694
        80, return 1108854319
        81, return 23946905134
        82, return 18561353263
        83, return 16660235326
        84, return 4433514655
        85, return 15621211697
        86, return 4648912433
        87, return 19182306865
        88, return 18834663985
        89, return 4433521201
        90, return 33321787935
        33, return 4299296900
        47, return 1143087376
        45, return 1015808
        46, return 6643777536
        60, return 8726284424
        62, return 2290622594
        58, return 207624384
        _, return 0
    end match
end fn

# ------------------------------------------------------------
# Small helpers
# ------------------------------------------------------------
fn pad(n: i32, w: i32): string
    var s := n.to_string()
    while s.len() < w
        s := "0" + s
    end while
    return s
end fn

# Fill one rectangular cell with a color (alpha 0 = blended ghost).
fn fill_cell(fb0: Vec<i32>, x0: i32, y0: i32, sz: i32, col: i32, alpha: i32): Vec<i32>
    var fb Vec<i32> := fb0
    loop yy y0..y0 + sz - 1
        loop xx x0..x0 + sz - 1
            if xx >= 0 and xx < WINW and yy >= 0 and yy < WINH,
                var idx i32 := yy * WINW + xx
                if alpha = 1,
                    fb[idx] := col
                else
                    var base i32 := fb[idx]
                    var br i32 := (base shift right 16) bitand 255
                    var bg i32 := (base shift right 8) bitand 255
                    var bb i32 := base bitand 255
                    var cr i32 := (col shift right 16) bitand 255
                    var cg i32 := (col shift right 8) bitand 255
                    var cb i32 := col bitand 255
                    var nr i32 := (br * 4 + cr) / 5
                    var ng i32 := (bg * 4 + cg) / 5
                    var nb i32 := (bb * 4 + cb) / 5
                    fb[idx] := (nr shift left 16) bitor (ng shift left 8) bitor nb
                end if
            end if
        end loop
    end loop
    return fb
end fn

fn fill_rect(fb0: Vec<i32>, x0: i32, y0: i32, w: i32, h: i32, col: i32): Vec<i32>
    var fb Vec<i32> := fb0
    loop yy y0..y0 + h - 1
        loop xx x0..x0 + w - 1
            if xx >= 0 and xx < WINW and yy >= 0 and yy < WINH,
                fb[yy * WINW + xx] := col
            end if
        end loop
    end loop
    return fb
end fn

# Draw a string with the 5x7 font, scaled by sc. fb moves in and out.
fn draw_glyph(fb0: Vec<i32>, text: string, x0: i32, y0: i32, sc: i32, col: i32): Vec<i32>
    var fb Vec<i32> := fb0
    var cx i32 := x0
    loop ch in text
        var g u64 := glyph(ch as i32)
        if g > 0,
            loop gy 0..6
                loop gx 0..4
                    var bit u64 := (g shift right (gy * 5 + gx)) bitand 1
                    if bit > 0,
                        loop py 0..sc - 1
                            loop px 0..sc - 1
                                var x i32 := cx + gx * sc + px
                                var y i32 := y0 + gy * sc + py
                                if x >= 0 and x < WINW and y >= 0 and y < WINH,
                                    fb[y * WINW + x] := col
                                end if
                            end loop
                        end loop
                    end if
                end loop
            end loop
        end if
        cx := cx + 6 * sc
    end loop
    return fb
end fn

# Draw a piece (kind t, spawn rotation) with PREV-sized cells, offset in cells.
fn draw_piece(fb0: Vec<i32>, t: i32, alpha: i32, off_x: i32, off_y: i32): Vec<i32>
    var fb Vec<i32> := fb0
    if t < 0,
        return fb
    end if
    var bits i32 := shape_bits(t * 4)
    loop r 0..3
        loop c 0..3
            if bit_at(bits, r, c),
                var x i32 := off_x + c * PREV
                var y i32 := off_y + r * PREV
    var sa i32 := 8
    if alpha < 1,
        sa := 2
    end if
                fb := draw_cell_sprite(fb, x, y, PREV, color_of(t), sa)
            end if
        end loop
    end loop
    return fb
end fn

# Centered draw of one piece inside a box (px coords).
fn draw_piece_box(fb0: Vec<i32>, t: i32, alpha: i32, bx: i32, by: i32, bw: i32, bh: i32): Vec<i32>
    var fb Vec<i32> := fb0
    if t < 0,
        return fb
    end if
    var bits i32 := shape_bits(t * 4)
    var w i32 := piece_w(bits) * PREV
    var h i32 := piece_h(bits) * PREV
    var ox i32 := bx + (bw - w) / 2
    var oy i32 := by + (bh - h) / 2
    loop r 0..3
        loop c 0..3
            if bit_at(bits, r, c),
    var sa i32 := 8
    if alpha < 1,
        sa := 2
    end if
                fb := draw_cell_sprite(fb, ox + c * PREV, oy + r * PREV, PREV, color_of(t), sa)
            end if
        end loop
    end loop
    return fb
end fn

# Draw one beveled cell sprite (the original page bakes these per color):
# flat fill, 45% white top/left edge, 45% black bottom/right edge, faint
# inner glow, and a 1px transparent gap around the cell. a is coverage in
# eighths: 8 = opaque, otherwise the whole cell is alpha-blended at a/8.
fn draw_cell_sprite(fb0: Vec<i32>, x0: i32, y0: i32, sz: i32, col: i32, a: i32): Vec<i32>
    var fb Vec<i32> := fb0
    if sz < 6,
        return fb
    end if
    var mm i32 := 1
    var ix i32 := x0 + mm
    var iy i32 := y0 + mm
    var iw i32 := sz - 2 * mm
    var edge i32 := (sz - 2 * mm) / 5
    if edge > 3,
        edge := 3
    end if
    var cr i32 := (col shift right 16) bitand 255
    var cg i32 := (col shift right 8) bitand 255
    var cb i32 := col bitand 255
    var hr i32 := (cr * 55 + 255 * 45) / 100
    var hg i32 := (cg * 55 + 255 * 45) / 100
    var hb i32 := (cb * 55 + 255 * 45) / 100
    var hcol i32 := (hr shift left 16) bitor (hg shift left 8) bitor hb
    var sr i32 := cr * 55 / 100
    var sg i32 := cg * 55 / 100
    var sb i32 := cb * 55 / 100
    var scol i32 := (sr shift left 16) bitor (sg shift left 8) bitor sb
    var gr i32 := (cr * 95 + 255 * 5) / 100
    var gg i32 := (cg * 95 + 255 * 5) / 100
    var gb i32 := (cb * 95 + 255 * 5) / 100
    var gcol i32 := (gr shift left 16) bitor (gg shift left 8) bitor gb
    if a >= 8,
        fb := fill_rect(fb, ix, iy, iw, iw, col)
        fb := fill_rect(fb, ix, iy, iw, edge, hcol)
        fb := fill_rect(fb, ix, iy, edge, iw, hcol)
        fb := fill_rect(fb, ix, iy + iw - edge, iw, edge, scol)
        fb := fill_rect(fb, ix + iw - edge, iy, edge, iw, scol)
        if iw > 8,
            fb := fill_rect(fb, ix + 4, iy + 4, iw - 8, iw - 8, gcol)
        end if
    else
        loop yy 0..iw - 1
            loop xx 0..iw - 1
                var px i32 := ix + xx
                var py i32 := iy + yy
                if px >= 0 and px < WINW and py >= 0 and py < WINH,
                    var idx i32 := py * WINW + px
                    var br i32 := (fb[idx] shift right 16) bitand 255
                    var obg i32 := (fb[idx] shift right 8) bitand 255
                    var bb i32 := fb[idx] bitand 255
                    var nr i32 := (br * (8 - a) + cr * a) / 8
                    var ng i32 := (obg * (8 - a) + cg * a) / 8
                    var nb i32 := (bb * (8 - a) + cb * a) / 8
                    fb[idx] := (nr shift left 16) bitor (ng shift left 8) bitor nb
                end if
            end loop
        end loop
    end if
    return fb
end fn

# ------------------------------------------------------------
# Structs
# ------------------------------------------------------------
struct Piece
    t: i32
    rot: i32
    row: i32
    col: i32
end struct

# 7-bag randomizer with a one-bag lookahead queue, like the original.
struct Bag
    q: Vec<i32>
    nq: Vec<i32>
    p: i32
    q_peek: i32
end struct

impl Bag
    # Fisher-Yates shuffle driven by the xorshift seed; returns new seed.
    fn shuffled(self, seed: u64): (Bag, u64)
        var arr Vec<i32> := [0, 1, 2, 3, 4, 5, 6]
        var i i32 := 6
        var s u64 := seed
        while i > 0
            s := s xor (s shift left 13)
            s := s xor (s shift right 7)
            s := s xor (s shift left 17)
            var j i32 := ((s shift right 33) as i32) mod i
            var tmp i32 := arr[i]
            arr[i] := arr[j]
            arr[j] := tmp
            i := i - 1
        end while
        self.q := arr
        return (self, s)
    end fn

    # Consume one piece; refills from the lookahead bag when exhausted.
    fn refill(self, seed: u64): (Bag, i32, u64)
        var b := self
        var s u64 := seed
        if b.p >= b.q.len(),
            # Destructure fully, swap queues (current := old lookahead), then
            # shuffle a fresh lookahead — every step is a whole-value move.
            var qv Vec<i32> := b.q
            var nqv Vec<i32> := b.nq
            var pv i32 := b.p
            var nb := Bag { q: nqv, nq: qv, p: 0, q_peek: 0 }
            var pair := nb.shuffled(s)
            nb := pair.0
            s := pair.1
            var q2 Vec<i32> := nb.q
            var nq2 Vec<i32> := nb.nq
            b := Bag { q: nq2, nq: q2, p: 0, q_peek: 0 }
        end if
        var v i32 := b.q[b.p]
        b.p := b.p + 1
        return (b, v, s)
    end fn

    # Peek offset pieces ahead (across the bag boundary). Stashes in q_peek
    # because primitive-returning methods would move the receiver.
    fn peek(self, off: i32): Bag
        var idx i32 := self.p + off
        if idx < self.q.len(),
            self.q_peek := self.q[idx]
        else if idx < self.q.len() + self.nq.len(),
            self.q_peek := self.nq[idx - self.q.len()]
        else
            self.q_peek := 0
        end if
        return self
    end fn
end impl

struct GameState
    grid: Vec<i32>
    q_hit: bool
    bag: Bag
    hold: i32
    can_hold: bool
    cur: Piece
    score: i32
    lines: i32
    level: i32
    game_over: bool
    paused: bool
    started: bool
    soft: bool
    accum: i64
    gms: i64
    high: i32
    das_l: i64
    das_r: i64
    last_t: i64
    fx_a: i32
    fx_t: i64
    fx_cells: Vec<i32>
    seed: u64
    q_ghost_row: i32
    q_scored: i32
    q_queue: Vec<i32>
end struct

# ------------------------------------------------------------
# GameState methods (all take-and-return; Poly moves `self`)
# ------------------------------------------------------------
impl GameState
    # Spawn a piece (forced >= 0 reuses that kind, e.g. from hold).
    fn spawn_piece(self, forced: i32): GameState
        var t i32 := forced
        if t < 0,
            var r := self.bag.refill(self.seed)
            self.bag := r.0
            self.seed := r.2
            t := r.1
        end if
        var w i32 := piece_w(shape_bits(t * 4))
        self.cur := Piece { t: t, rot: 0, row: BUF, col: (COLS - w) / 2 }
        return self
    end fn

    # Collision test. Stashes the answer in q_hit (a Copy field) so callers
    # keep ownership of self; a bool-returning method would move the receiver.
    fn collides(self, t: i32, rot: i32, row: i32, col: i32): GameState
        var bits i32 := shape_bits(t * 4 + rot)
        self.q_hit := false
        loop r 0..3
            loop c 0..3
                if bit_at(bits, r, c),
                    var rr i32 := row + r
                    var cc i32 := col + c
                    if cc < 0 or cc >= COLS,
                        self.q_hit := true
                    end if
                    if rr >= TOTAL,
                        self.q_hit := true
                    end if
                    if rr >= 0 and rr < TOTAL,
                        if self.grid[rr * COLS + cc] > 0,
                            self.q_hit := true
                        end if
                    end if
                end if
            end loop
        end loop
        return self
    end fn

    fn move_h(self, dx: i32): GameState
        var t i32 := self.cur.t
        var rot i32 := self.cur.rot
        var row i32 := self.cur.row
        var col i32 := self.cur.col
        self := self.collides(t, rot, row, col + dx)
        if not self.q_hit,
            self.cur.col := self.cur.col + dx
            audio_play(0)
        end if
        return self
    end fn

    fn rotate(self, dir: i32): GameState
        var nr i32 := (self.cur.rot + dir + 4) mod 4
        var kicks Vec<i32> := [0, -1, 1, -2, 2]
        var t i32 := self.cur.t
        var row i32 := self.cur.row
        var col i32 := self.cur.col
        loop k in kicks.iter()
            self := self.collides(t, nr, row, col + k)
            if not self.q_hit,
                self.cur.col := self.cur.col + k
                self.cur.rot := nr
                audio_play(1)
                return self
            end if
        end loop
        return self
    end fn

    fn hard_drop(self): GameState
        var d i32 := 0
        var t i32 := self.cur.t
        var rot i32 := self.cur.rot
        var col i32 := self.cur.col
        var row i32 := self.cur.row
        self := self.collides(t, rot, row + 1, col)
        while not self.q_hit
            self := self.collides(t, rot, row + 1, col)
            if not self.q_hit,
                row := row + 1
                d := d + 1
            end if
        end while
        self.cur.row := row
        self.score := self.score + d * 2
        audio_play(6)
        self := self.lock()
        return self
    end fn

    fn do_hold(self): GameState
        if not self.can_hold,
            audio_play(0)
            return self
        end if
        var cur i32 := self.cur.t
        if self.hold < 0,
            self.hold := cur
            self := self.spawn_piece(-1)
        else
            var sw i32 := self.hold
            self.hold := cur
            self := self.spawn_piece(sw)
        end if
        self.can_hold := false
        audio_play(1)
        return self
    end fn

    fn toggle_pause(self): GameState
        if self.started and not self.game_over,
            self.paused := not self.paused
        end if
        return self
    end fn

    fn toggle_mute(self): GameState
        audio_play(8)
        return self
    end fn

    fn restart(self): GameState
        var hi i32 := self.high
        var sd u64 := self.seed
        var fresh := make_game(sd, hi)
        return fresh
    end fn

    # Lock the current piece, clear lines, spawn the next one; game over
    # when the fresh spawn already collides (topping out), like the original.
    fn lock(self): GameState
        var bits i32 := shape_bits(self.cur.t * 4 + self.cur.rot)
        loop r 0..3
            loop c 0..3
                if bit_at(bits, r, c),
                    var rr i32 := self.cur.row + r
                    var cc i32 := self.cur.col + c
                    if rr >= 0 and rr < TOTAL,
                        self.grid[rr * COLS + cc] := self.cur.t + 1
                    end if
                end if
            end loop
        end loop
        audio_play(2)
        self.can_hold := true
        self := self.clear_lines()
        self := self.spawn_piece(-1)
        var ct i32 := self.cur.t
        var crot i32 := self.cur.rot
        var crow i32 := self.cur.row
        var ccol i32 := self.cur.col
        self := self.collides(ct, crot, crow, ccol)
        if self.q_hit,
            self.game_over := true
            self.started := false
            self.paused := false
            audio_play(7)
            if self.score > self.high,
                self.high := self.score
                highscore_save(self.score)
            end if
        end if
        return self
    end fn

    # Detect full rows, score NES-style, drop the cleared rows atomically.
    fn clear_lines(self): GameState
        var full Vec<i32> := []
        loop r BUF..TOTAL - 1
            var all bool := true
            loop c 0..COLS - 1
                if self.grid[r * COLS + c] = 0,
                    all := false
                end if
            end loop
            if all,
                full.push(r)
            end if
        end loop
        if full.len() = 0,
            return self
        end if
        var n i32 := full.len()
        if n = 1,
            self.score := self.score + 40 * (self.level + 1)
        else if n = 2,
            self.score := self.score + 100 * (self.level + 1)
        else if n = 3,
            self.score := self.score + 300 * (self.level + 1)
        else
            self.score := self.score + 800 * (self.level + 1)
        end if
        self.lines := self.lines + n
        var nl i32 := self.lines / 10
        if nl > self.level,
            self.level := nl
            self.gms := gravity_ms(self.level)
        end if
        if n = 4,
            audio_play(4)
        else
            audio_play(3)
        end if
        self.fx_a := n
        self.fx_t := now_ms()
        # capture the cleared rows' cells for the fading ghost overlay
        var fcells Vec<i32> := []
        loop f in full.iter()
            loop c 0..COLS - 1
                fcells.push(self.grid[f * COLS + c])
            end loop
        end loop
        self.fx_cells := fcells
        # compact surviving rows, then pad with empties on top
        var keep Vec<i32> := []
        loop r BUF..TOTAL - 1
            var is_full bool := false
            loop f in full.iter()
                if f = r,
                    is_full := true
                end if
            end loop
            if not is_full,
                loop c 0..COLS - 1
                    keep.push(self.grid[r * COLS + c])
                end loop
            end if
        end loop
        var ng Vec<i32> := []
        loop i 0..BUF * COLS - 1
            ng.push(0)
        end loop
        var empty_rows i32 := ROWS - keep.len() / COLS
        loop i 0..empty_rows * COLS - 1
            ng.push(0)
        end loop
        loop v in keep.iter()
            ng.push(v)
        end loop
        self.grid := ng
        return self
    end fn

    fn gravity(self, dt: i64): GameState
        if not self.started or self.paused or self.game_over,
            return self
        end if
        var stepms i64 := self.gms
        if self.soft,
            stepms := stepms / 12
            if stepms < 20,
                stepms := 20
            end if
        end if
        self.accum := self.accum + dt
        while self.accum >= stepms
            self.accum := self.accum - stepms
            var gt i32 := self.cur.t
            var grot i32 := self.cur.rot
            var grow i32 := self.cur.row
            var gcol i32 := self.cur.col
            self := self.collides(gt, grot, grow + 1, gcol)
            if self.q_hit,
                self.accum := 0
                self := self.lock()
                return self
            end if
            self.cur.row := self.cur.row + 1
            if self.soft,
                self.score := self.score + 1
            end if
        end while
        return self
    end fn

    # ---- queries: stash results in q_* fields (Copy) ----

    # Where would the current piece land?
    fn query_drop(self): GameState
        var row i32 := self.cur.row
        var t i32 := self.cur.t
        var rot i32 := self.cur.rot
        var col i32 := self.cur.col
        self := self.collides(t, rot, row + 1, col)
        while not self.q_hit
            row := row + 1
            self := self.collides(t, rot, row + 1, col)
        end while
        self.q_ghost_row := row
        return self
    end fn

    # Cell value (0 = empty, else kind+1); out-of-bounds reads 0.
    fn query_cell(self, row: i32, col: i32): GameState
        self.q_scored := 0
        if row >= 0 and row < TOTAL and col >= 0 and col < COLS,
            self.q_scored := self.grid[row * COLS + col]
        end if
        return self
    end fn

    # The 5-piece upcoming queue.
    fn query_queue(self): GameState
        var b := self.bag
        var out Vec<i32> := []
        loop i 0..4
            b := b.peek(i)
            out.push(b.q_peek)
        end loop
        self.bag := b
        self.q_queue := out
        return self
    end fn

    # Fresh game state is built by the free fn make_game below — a self
    # method cannot be called repeatedly because Poly moves the receiver.
end impl

# Build a fresh game; pass high=highscore_load() for a new session or an
# existing score to preserve it across restarts.
fn make_game(seed: u64, high: i32): GameState
    var b := Bag { q: [], nq: [], p: 0, q_peek: 0 }
    var pair := b.shuffled(seed)
    b := pair.0
    var s := GameState {
        grid: [],
        q_hit: false,
        bag: b,
        hold: -1,
        can_hold: true,
        cur: Piece { t: 0, rot: 0, row: 0, col: 0 },
        score: 0,
        lines: 0,
        level: 0,
        game_over: false,
        paused: false,
        started: false,
        soft: false,
        accum: 0,
        gms: gravity_ms(0),
        high: high,
        das_l: 0,
        das_r: 0,
        last_t: 0,
        fx_a: 0,
        fx_t: 0,
        fx_cells: [],
        seed: pair.1,
        q_ghost_row: 0,
        q_scored: 0,
        q_queue: []
    }
    loop i 0..TOTAL * COLS - 1
        s.grid.push(0)
    end loop
    s := s.spawn_piece(-1)
    return s
end fn

# ------------------------------------------------------------
# Rendering (free functions; state moves in, (state, fb) moves out)
# ------------------------------------------------------------
fn make_fb(): Vec<i32>
    var fb Vec<i32> := []
    loop i 0..WINW * WINH - 1
        fb.push(BG)
    end loop
    return fb
end fn

fn render_frame(s0: GameState, fb0: Vec<i32>): (GameState, Vec<i32>)
    var s := s0
    var fb Vec<i32> := fb0

    # page gradient: dark plum fading down (bg-2 at top to bg-0), like the
    # original's radial background
    loop y 0..WINH - 1
        var t i32 := y * 255 / WINH
        var r i32 := (21 * (255 - t) + 5 * t) / 255
        var g i32 := (8 * (255 - t) + 1 * t) / 255
        var bch i32 := (61 * (255 - t) + 10 * t) / 255
        fb := fill_rect(fb, 0, y, WINW, 1, (r shift left 16) bitor (g shift left 8) bitor bch)
    end loop

    # board frame + grid
    fb := fill_rect(fb, BX - 1, BY - 1, BW + 2, BH + 2, PANELB)
    fb := fill_rect(fb, BX, BY, BW, BH, GRIDBG)
    loop gx 1..COLS - 1
        fb := fill_rect(fb, BX + gx * CELL, BY, 1, BH, GRIDLN)
    end loop
    loop gy 1..ROWS - 1
        fb := fill_rect(fb, BX, BY + gy * CELL, BW, 1, GRIDLN)
    end loop

    # locked cells (beveled sprites)
    loop row BUF..TOTAL - 1
        loop col 0..COLS - 1
            var v i32 := s.grid[row * COLS + col]
            if v > 0,
                var x i32 := BX + col * CELL
                var y i32 := BY + (row - BUF) * CELL
                fb := draw_cell_sprite(fb, x, y, CELL, color_of(v - 1), 8)
            end if
        end loop
    end loop

    # ghost + active piece
    if not s.game_over,
        var bits i32 := shape_bits(s.cur.t * 4 + s.cur.rot)
        if s.started,
            var s2 := s.query_drop()
            s := s2
            var grow i32 := s.q_ghost_row
            loop r 0..3
                loop c 0..3
                    if bit_at(bits, r, c),
                        var row i32 := grow + r
                        var col i32 := s.cur.col + c
                        if row >= BUF and row < TOTAL,
                            var x i32 := BX + col * CELL
                            var y i32 := BY + (row - BUF) * CELL
                            fb := draw_cell_sprite(fb, x, y, CELL, color_of(s.cur.t), 2)
                        end if
                    end if
                end loop
            end loop
        end if
        loop r 0..3
            loop c 0..3
                if bit_at(bits, r, c),
                    var row i32 := s.cur.row + r
                    var col i32 := s.cur.col + c
                    if row >= BUF and row < TOTAL,
                        var x i32 := BX + col * CELL
                        var y i32 := BY + (row - BUF) * CELL
                        fb := draw_cell_sprite(fb, x, y, CELL, color_of(s.cur.t), 8)
                    end if
                end if
            end loop
        end loop
    end if

    # line-clear flash: the cleared rows' captured cells fade in the top
    # slots, like the original's flashes array (alpha 1.0 down to 0.4)
    if s.fx_a > 0 and now_ms() - s.fx_t < FADE as i64,
        var age i64 := now_ms() - s.fx_t
        var a i32 := 8 - age as i32 / 36
        var slot i32 := 0
        loop i 0..s.fx_a - 1
            loop c 0..COLS - 1
                var v i32 := s.fx_cells[slot * COLS + c]
                if v > 0,
                    var x i32 := BX + c * CELL
                    var y i32 := BY + slot * CELL
                    fb := draw_cell_sprite(fb, x, y, CELL, color_of(v - 1), a)
                end if
            end loop
            slot := slot + 1
        end loop
    end if

    # ---- left panel: stats + hold ----
    var lx i32 := PX0
    fb := draw_glyph(fb, "SCORE", lx, 24, 2, WHITE)
    fb := draw_glyph(fb, pad(s.score, 6), lx, 44, 2, CYNE)
    fb := draw_glyph(fb, "HIGH", lx, 74, 2, WHITE)
    fb := draw_glyph(fb, pad(s.high, 6), lx, 94, 2, YELLOW)
    fb := draw_glyph(fb, "LEVEL", lx, 124, 2, WHITE)
    fb := draw_glyph(fb, pad(s.level, 2), lx, 144, 2, CYNE)
    fb := draw_glyph(fb, "LINES", lx, 174, 2, WHITE)
    fb := draw_glyph(fb, pad(s.lines, 3), lx, 194, 2, CYNE)
    fb := draw_glyph(fb, "HOLD", lx, 232, 2, WHITE)
    fb := fill_rect(fb, lx - 2, 252, PW + 4, 4 * PREV + 8, PANELB)
    fb := fill_rect(fb, lx - 1, 253, PW + 2, 4 * PREV + 6, GRIDBG)
    var halpha i32 := 8
    if not s.can_hold,
        halpha := 2
    end if
    fb := draw_piece_box(fb, s.hold, halpha, lx, 256, PW, 4 * PREV)

    # ---- right panel: next-5 queue + controls ----
    var rx i32 := PX1
    fb := draw_glyph(fb, "NEXT", rx, 24, 2, WHITE)
    var sq := s.query_queue()
    s := sq
    loop i 0..4
        var y i32 := 44 + i * (4 * PREV + 10)
        if i = 0,
            fb := fill_rect(fb, rx - 2, y - 2, PW + 4, 4 * PREV + 8, PANELB)
        end if
        fb := fill_rect(fb, rx - 1, y - 1, PW + 2, 4 * PREV + 6, GRIDBG)
        var pal i32 := 2
        if i = 0,
            pal := 8
        end if
        fb := draw_piece_box(fb, s.q_queue[i], pal, rx, y, PW, 4 * PREV)
    end loop
    fb := draw_glyph(fb, "CONTROLS", rx, 502, 2, WHITE)
    fb := draw_glyph(fb, "< > MOVE", rx, 522, 1, DIM)
    fb := draw_glyph(fb, "V SOFT DROP", rx, 536, 1, DIM)
    fb := draw_glyph(fb, "^ ROTATE", rx, 550, 1, DIM)
    fb := draw_glyph(fb, "Z CCW", rx, 564, 1, DIM)
    fb := draw_glyph(fb, "SPACE HARD DROP", rx, 578, 1, DIM)
    fb := draw_glyph(fb, "C HOLD", rx, 592, 1, DIM)
    fb := draw_glyph(fb, "P PAUSE", rx, 606, 1, DIM)
    fb := draw_glyph(fb, "R RESTART", rx, 620, 1, DIM)
    fb := draw_glyph(fb, "M SOUND", rx, 634, 1, DIM)
    fb := draw_glyph(fb, "ESC QUIT", rx, 648, 1, DIM)

    # overlays
    if not s.started and not s.game_over,
        fb := draw_glyph(fb, "PRESS ENTER", BX + BW / 2 - 66, BY + BH / 2 - 7, 2, WHITE)
    end if
    if s.paused,
        fb := draw_glyph(fb, "PAUSED", BX + BW / 2 - 36, BY + BH / 2 - 7, 2, YELLOW)
    end if
    if s.game_over,
        fb := fill_rect(fb, BX + 10, BY + BH / 2 - 30, BW - 20, 64, 0)
        fb := draw_glyph(fb, "GAME OVER", BX + BW / 2 - 54, BY + BH / 2 - 21, 2, RED)
        fb := draw_glyph(fb, "ENTER TO RESTART", BX + BW / 2 - 48, BY + BH / 2 + 8, 1, DIM)
    end if

    # CRT scanlines over the playfield: subtle dark stripes (18% black at
    # 55% opacity, like the original's .crt-overlay), blended over whatever
    # is beneath instead of painting opaque bars over pieces.
    loop sy 0..BH / 2 - 1
        loop sx 0..BW - 1
            var x i32 := BX + sx
            var y i32 := BY + sy * 2 + 1
            var v i32 := fb[y * WINW + x]
            var r i32 := (v shift right 16) bitand 255
            var g i32 := (v shift right 8) bitand 255
            var b i32 := v bitand 255
            r := r * 90 / 100
            g := g * 90 / 100
            b := b * 90 / 100
            fb[y * WINW + x] := (r shift left 16) bitor (g shift left 8) bitor b
        end loop
    end loop

    return (s, fb)
end fn

# ------------------------------------------------------------
# GUI main loop
# ------------------------------------------------------------
fn run_gui(s0: GameState)
    var s := s0
    audio_init()
    if not win_open(WINW, WINH, "TETRIS"),
        error "could not open window"
    end if
    var prev Vec<i32> := []
    s.last_t := now_ms()
    loop
        if not win_alive(),
            break
        end if
        var now i32 := now_ms() as i32
        var dt i64 := now as i64 - s.last_t
        if dt > 250 as i64,
            dt := 250
        end if
        s.last_t := now as i64

        var keys Vec<i32> := win_keys()
        var quit bool := false

        # --- pressed edges (in `keys` but not in `prev`) ---
        loop k in keys.iter()
            var fresh bool := true
            loop p in prev.iter()
                if p = k,
                    fresh := false
                end if
            end loop
            if fresh,
                if k = 27,
                    quit := true
                end if
                if k = 13,
                    if s.game_over,
                        s := s.restart()
                    else if not s.started,
                        s.started := true
                    end if
                end if
                if k = 37,
                    if s.started and not s.paused and not s.game_over,
                        s := s.move_h(-1)
                    end if
                    s.das_l := now as i64
                end if
                if k = 39,
                    if s.started and not s.paused and not s.game_over,
                        s := s.move_h(1)
                    end if
                    s.das_r := now as i64
                end if
                if k = 38 or k = 88,
                    if s.started and not s.paused and not s.game_over,
                        s := s.rotate(1)
                    end if
                end if
                if k = 90,
                    if s.started and not s.paused and not s.game_over,
                        s := s.rotate(-1)
                    end if
                end if
                if k = 32,
                    if s.started and not s.paused and not s.game_over,
                        s := s.hard_drop()
                    end if
                end if
                if k = 67,
                    if s.started and not s.paused and not s.game_over,
                        s := s.do_hold()
                    end if
                end if
                if k = 80,
                    s := s.toggle_pause()
                end if
                if k = 82,
                    s := s.restart()
                end if
                if k = 77,
                    s := s.toggle_mute()
                end if
            end if
        end loop

        if quit,
            break
        end if

        # --- soft drop while Down held ---
        var down_held bool := false
        loop k in keys.iter()
            if k = 40 or k = 86,
                down_held := true
            end if
        end loop
        s.soft := down_held

        # --- DAS auto-repeat while held ---
        loop k in keys.iter()
            if k = 37,
                if now as i64 - s.das_l > DAS_DELAY as i64,
                    if s.started and not s.paused and not s.game_over,
                        s := s.move_h(-1)
                    end if
                    s.das_l := now as i64 - DAS_RATE as i64
                end if
            end if
            if k = 39,
                if now as i64 - s.das_r > DAS_DELAY as i64,
                    if s.started and not s.paused and not s.game_over,
                        s := s.move_h(1)
                    end if
                    s.das_r := now as i64 - DAS_RATE as i64
                end if
            end if
        end loop

        prev := keys
        s := s.gravity(dt)

        var fb := make_fb()
        var rf := render_frame(s, fb)
        s := rf.0
        if not win_present(rf.1, WINW, WINH),
            break
        end if
    end loop
    win_close()
end fn

# ------------------------------------------------------------
# Headless logic self-test (--test)
# ------------------------------------------------------------
fn run_selftest(s0: GameState)
    var s := s0
    put "POLY TETRIS self-test"
    var fails i32 := 0

    # every rotation of every piece has exactly 4 cells
    loop t 0..6
        loop rot 0..3
            var bits i32 := shape_bits(t * 4 + rot)
            var n i32 := 0
            loop r 0..3
                loop c 0..3
                    if bit_at(bits, r, c),
                        n := n + 1
                    end if
                end loop
            end loop
            if n != 4,
                fails := fails + 1
                put "FAIL shape cells"
            end if
        end loop
    end loop

    # O piece is rotation invariant
    loop rot 0..3
        if shape_bits(4 + rot) != 51,
            fails := fails + 1
            put "FAIL O invariance"
        end if
    end loop

    # gravity table
    if gravity_ms(0) != 800 as i64,
        fails := fails + 1
        put "FAIL gravity0"
    end if
    if gravity_ms(29) != 16 as i64,
        fails := fails + 1
        put "FAIL gravity29"
    end if
    if gravity_ms(99) != 16 as i64,
        fails := fails + 1
        put "FAIL gravity-cap"
    end if

    # font + colors + pad
    if glyph(48) < 1 or glyph(90) < 1 or glyph(64) > 0,
        fails := fails + 1
        put "FAIL font"
    end if
    if color_of(0) != 0x2BF2FF,
        fails := fails + 1
        put "FAIL color"
    end if
    if pad(42, 6) != "000042",
        fails := fails + 1
        put "FAIL pad"
    end if

    # spawn centers the piece in the buffer row
    var sg := make_game(s.seed, highscore_load())
    var g := sg
    if g.cur.row != BUF,
        fails := fails + 1
        put "FAIL spawn row"
    end if
    if g.cur.col != (COLS - piece_w(shape_bits(g.cur.t * 4))) / 2,
        fails := fails + 1
        put "FAIL spawn col"
    end if

    # 7-bag: the current bag holds all 7 kinds exactly once
    var counts Vec<i32> := [0, 0, 0, 0, 0, 0, 0]
    loop i 0..6
        counts[g.bag.q[i]] := counts[g.bag.q[i]] + 1
    end loop
    loop t 0..6
        if counts[t] != 1,
            fails := fails + 1
            put "FAIL bag"
        end if
    end loop
    # lookahead queue: peek(0..4) matches the next bag slots after the
    # already-spawned piece
    var okq bool := true
    loop i 0..4
        var bp := g.bag.peek(i)
        g.bag := bp
        var expect i32 := g.bag.q[1 + i]
        if g.bag.q_peek != expect,
            okq := false
        end if
    end loop
    if not okq,
        fails := fails + 1
        put "FAIL queue-peek"
    end if

    # collisions: empty board spawn is free; walls and floor collide
    var gt i32 := g.cur.t
    var grot i32 := g.cur.rot
    var grow i32 := g.cur.row
    var gcol i32 := g.cur.col
    g := g.collides(gt, grot, grow, gcol)
    if g.q_hit,
        fails := fails + 1
        put "FAIL collide-empty"
    end if
    g := g.collides(gt, grot, grow, -1)
    if not g.q_hit,
        fails := fails + 1
        put "FAIL collide-wall"
    end if
    g := g.collides(gt, grot, TOTAL, gcol)
    if not g.q_hit,
        fails := fails + 1
        put "FAIL collide-floor"
    end if

    # cell reads
    g.grid[10 * COLS + 5] := 4
    g := g.query_cell(10, 5)
    if g.q_scored != 4,
        fails := fails + 1
        put "FAIL cell-read"
    end if
    g := g.query_cell(11, 5)
    if g.q_scored != 0,
        fails := fails + 1
        put "FAIL cell-empty"
    end if
    g := g.query_cell(-1, 0)
    if g.q_scored != 0,
        fails := fails + 1
        put "FAIL cell-bounds"
    end if

    # single line clear: score, counter, row removal
    var sg2 := make_game(s.seed, highscore_load())
    var g2 := sg2
    loop c 0..COLS - 1
        g2.grid[(TOTAL - 1) * COLS + c] := 3
    end loop
    var before i32 := g2.score
    g2 := g2.clear_lines()
    if g2.score != before + 40,
        fails := fails + 1
        put "FAIL clear-score"
    end if
    if g2.lines != 1,
        fails := fails + 1
        put "FAIL clear-lines"
    end if
    g2 := g2.query_cell(TOTAL - 1, 5)
    if g2.q_scored != 0,
        fails := fails + 1
        put "FAIL clear-removes"
    end if

    # stack preservation: a single cleared row must leave other rows intact
    var sg9 := make_game(s.seed, highscore_load())
    var g9 := sg9
    # bottom row full (will be cleared), row above has two blocks in cols 0,1
    loop c 0..COLS - 1
        g9.grid[(TOTAL - 1) * COLS + c] := 1
    end loop
    g9.grid[(TOTAL - 2) * COLS + 0] := 2
    g9.grid[(TOTAL - 2) * COLS + 1] := 2
    g9 := g9.clear_lines()
    if g9.grid[(TOTAL - 1) * COLS + 0] != 2,
        fails := fails + 1
        put "FAIL stack-survives-a"
    end if
    if g9.grid[(TOTAL - 1) * COLS + 1] != 2,
        fails := fails + 1
        put "FAIL stack-survives-b"
    end if
    if g9.grid[(TOTAL - 1) * COLS + 5] != 0,
        fails := fails + 1
        put "FAIL stack-cleared-col"
    end if
    if g9.grid[(TOTAL - 2) * COLS + 0] != 0,
        fails := fails + 1
        put "FAIL stack-row-above-empty"
    end if

    # tetris scoring
    var sg3 := make_game(s.seed, highscore_load())
    var g3 := sg3
    loop r TOTAL - 4..TOTAL - 1
        loop c 0..COLS - 1
            g3.grid[r * COLS + c] := 3
        end loop
    end loop
    var b3 i32 := g3.score
    g3 := g3.clear_lines()
    if g3.score != b3 + 800,
        fails := fails + 1
        put "FAIL tetris-score"
    end if

    # hard drop locks exactly 4 cells on the floor
    var sg4 := make_game(s.seed, highscore_load())
    var g4 := sg4
    g4.started := true
    g4 := g4.hard_drop()
    var landed i32 := 0
    loop r BUF..TOTAL - 1
        loop c 0..COLS - 1
            if g4.grid[r * COLS + c] > 0,
                landed := landed + 1
            end if
        end loop
    end loop
    if landed != 4,
        fails := fails + 1
        put "FAIL harddrop-lock"
    end if

    # hold stores, second hold is denied until next lock
    var sg5 := make_game(s.seed, highscore_load())
    var g5 := sg5
    g5.started := true
    var t0 i32 := g5.cur.t
    g5 := g5.do_hold()
    if g5.hold != t0,
        fails := fails + 1
        put "FAIL hold-store"
    end if
    var t1 i32 := g5.cur.t
    g5 := g5.do_hold()
    if g5.hold != t0 or g5.cur.t != t1,
        fails := fails + 1
        put "FAIL hold-deny"
    end if

    # ghost lands on the floor of an empty board
    var sg6 := make_game(s.seed, highscore_load())
    var g6 := sg6
    g6 := g6.query_drop()
    var exp i32 := TOTAL - piece_h(shape_bits(g6.cur.t * 4))
    if g6.q_ghost_row != exp,
        fails := fails + 1
        put "FAIL ghost"
    end if

    # movement clamps to the left wall
    var sg7 := make_game(s.seed, highscore_load())
    var g7 := sg7
    g7.started := true
    loop i 0..20
        g7 := g7.move_h(-1)
    end loop
    var minc i32 := 99
    var bits7 i32 := shape_bits(g7.cur.t * 4 + g7.cur.rot)
    loop r 0..3
        loop c 0..3
            if bit_at(bits7, r, c),
                if g7.cur.col + c < minc,
                    minc := g7.cur.col + c
                end if
            end if
        end loop
    end loop
    if minc < 0,
        fails := fails + 1
        put "FAIL wall-clamp"
    end if

    # queue query returns 5 kinds in range
    var sg8 := make_game(s.seed, highscore_load())
    var g8 := sg8
    g8 := g8.query_queue()
    if g8.q_queue.len() != 5,
        fails := fails + 1
        put "FAIL queue-len"
    end if
    loop i 0..4
        if g8.q_queue[i] < 0 or g8.q_queue[i] > 6,
            fails := fails + 1
            put "FAIL queue-range"
        end if
    end loop

    if fails = 0,
        put "ALL TESTS PASSED"
    else
        put fails.to_string() + " FAILURES"
    end if
end fn

# ------------------------------------------------------------
# Entry point
# ------------------------------------------------------------
fn main()
    var args := get_args()
    var test_mode bool := false
    loop a in args.iter()
        if a = "--test",
            test_mode := true
        end if
    end loop

    var s := make_game(rng_seed(), highscore_load())

    if test_mode,
        run_selftest(s)
    else
        run_gui(s)
    end if
end fn

#rust
// ================= platform layer (Rust) =================

use minifb::{Key, Window, WindowOptions};
use std::cell::RefCell;

thread_local! {
    static WINDOW: RefCell<Option<Window>> = const { RefCell::new(None) };
    static AUDIO_TX: RefCell<Option<std::sync::mpsc::Sender<Vec<i16>>>> = const { RefCell::new(None) };
    static PHASE: RefCell<f32> = const { RefCell::new(0.0) };
}

// ---- window ----

fn win_open(width: i32, height: i32, title: String) -> bool {
    let mut opts = WindowOptions::default();
    opts.resize = false;
    opts.scale = minifb::Scale::X1;
    match Window::new(&title, width as usize, height as usize, opts) {
        Ok(mut win) => {
            win.limit_update_rate(Some(std::time::Duration::from_micros(16666)));
            WINDOW.with(|c| *c.borrow_mut() = Some(win));
            true
        }
        Err(_) => false,
    }
}

fn win_alive() -> bool {
    WINDOW.with(|c| match c.borrow().as_ref() {
        Some(w) => w.is_open() && !w.is_key_down(Key::Escape),
        None => false,
    })
}

// Poly key codes: Enter=13 Left=37 Up=38 Right=39 Down=40 Space=32 Z=90 X=88 C=67 P=80 R=82 M=77
fn map_key(k: Key) -> Option<i32> {
    Some(match k {
        Key::Enter => 13,
        Key::Left => 37,
        Key::Up => 38,
        Key::Right => 39,
        Key::Down => 40,
        Key::Space => 32,
        Key::Z => 90,
        Key::X => 88,
        Key::C => 67,
        Key::P => 80,
        Key::R => 82,
        Key::M => 77,
        _ => return None,
    })
}

fn win_keys() -> Vec<i32> {
    WINDOW.with(|c| match c.borrow().as_ref() {
        Some(w) => w.get_keys().iter().filter_map(|k| map_key(*k)).collect(),
        None => Vec::new(),
    })
}

fn win_present(pixels: Vec<i32>, width: i32, height: i32) -> bool {
    let frame: Vec<u32> = pixels.iter().map(|p| *p as u32).collect();
    WINDOW.with(|c| match c.borrow_mut().as_mut() {
        Some(w) => w
            .update_with_buffer(&frame, width as usize, height as usize)
            .is_ok(),
        None => false,
    })
}

fn win_close() {
    WINDOW.with(|c| *c.borrow_mut() = None);
}

// ---- misc platform ----

fn get_args() -> Vec<String> {
    std::env::args().collect()
}

fn now_ms() -> i64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.as_millis() as i64)
        .unwrap_or(0)
}

fn highscore_load() -> i32 {
    std::fs::read_to_string("tetris.hs")
        .ok()
        .and_then(|s| s.trim().parse::<i32>().ok())
        .unwrap_or(0)
}

fn highscore_save(v: i32) {
    let _ = std::fs::write("tetris.hs", v.to_string());
}

fn rng_seed() -> u64 {
    let nanos = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.subsec_nanos() as u64 ^ (d.as_secs() << 32))
        .unwrap_or(42);
    nanos ^ (nanos << 31) ^ 0x9E3779B97F4A7C15
}

// ---- audio: tiny synth via ALSA, no asset dependencies ----
// Poly kind codes:
//   0 move, 1 rotate, 2 lock, 3 clear, 4 tetris, 6 hard drop,
//   7 game over, 8 mute blip

const RATE: usize = 44100;

fn render_tone(freq: u32, dur_ms: u64, wave: u8, vol: f32, slide: u32) -> Vec<i16> {
    let n = (RATE * dur_ms as usize) / 1000;
    let f0 = freq as f32;
    let f1 = if slide > 0 { slide as f32 } else { f0 };
    let mut out = Vec::with_capacity(n);
    for i in 0..n {
        let t = i as f32 / n.max(1) as f32;
        let f = f0 + (f1 - f0) * t;
        PHASE.with(|p| {
            let mut ph = p.borrow_mut();
            *ph += f / RATE as f32;
            if *ph >= 1.0 {
                *ph -= 1.0;
            }
            let s = match wave {
                0 => {
                    if *ph < 0.5 {
                        1.0
                    } else {
                        -1.0
                    }
                }
                1 => 4.0 * (*ph - 0.5).abs() - 1.0,
                _ => 2.0 * *ph - 1.0,
            };
            let env = (1.0 - t) * (1.0 - t);
            out.push((s * vol * env * 32767.0) as i16);
        });
    }
    out
}

fn mix(a: &[i16], b: &[i16]) -> Vec<i16> {
    let n = a.len().max(b.len());
    (0..n)
        .map(|i| {
            let x = a.get(i).copied().unwrap_or(0) as i32;
            let y = b.get(i).copied().unwrap_or(0) as i32;
            (x + y).clamp(i16::MIN as i32, i16::MAX as i32) as i16
        })
        .collect()
}

fn audio_init() {
    AUDIO_TX.with(|c| {
        if c.borrow().is_some() {
            return;
        }
        let (tx, rx) = std::sync::mpsc::channel::<Vec<i16>>();
        *c.borrow_mut() = Some(tx);
        std::thread::spawn(move || {
            let pcm = match alsa::pcm::PCM::new("default", alsa::Direction::Playback, false) {
                Ok(p) => p,
                Err(_) => return,
            };
            {
                let hwp = match alsa::pcm::HwParams::any(&pcm) {
                    Ok(h) => h,
                    Err(_) => return,
                };
                let _ = hwp.set_channels(1);
                let _ = hwp.set_format(alsa::pcm::Format::s16());
                let _ = hwp.set_rate(RATE as u32, alsa::ValueOr::Nearest);
                let _ = hwp.set_access(alsa::pcm::Access::RWInterleaved);
                if pcm.hw_params(&hwp).is_err() {
                    return;
                }
                let _ = pcm.prepare();
            }
            let io = match pcm.io_i16() {
                Ok(io) => io,
                Err(_) => return,
            };
            while let Ok(samples) = rx.recv() {
                let mut i = 0;
                while i < samples.len() {
                    match io.writei(&samples[i..]) {
                        Ok(n) if n > 0 => i += n,
                        _ => {
                            let _ = pcm.prepare();
                        }
                    }
                }
            }
        });
    });
}

fn audio_play(kind: i32) {
    AUDIO_TX.with(|c| {
        if let Some(tx) = c.borrow().as_ref() {
            let msg: Option<Vec<i16>> = match kind {
                0 => Some(render_tone(180, 40, 0, 0.04, 0)),
                1 => Some(render_tone(280, 50, 0, 0.05, 0)),
                2 => Some(render_tone(120, 70, 0, 0.07, 80)),
                3 => Some(mix(
                    &render_tone(440, 80, 1, 0.08, 0),
                    &render_tone(660, 100, 1, 0.08, 0),
                )),
                4 => {
                    let mut v = mix(&render_tone(523, 100, 1, 0.10, 0), &render_tone(659, 100, 1, 0.10, 0));
                    v = mix(&v, &render_tone(784, 100, 1, 0.10, 0));
                    v = mix(&v, &render_tone(1046, 180, 1, 0.10, 0));
                    Some(v)
                }
                6 => Some(render_tone(90, 50, 2, 0.05, 50)),
                7 => {
                    let mut v = render_tone(220, 180, 0, 0.08, 110);
                    v = mix(&v, &render_tone(160, 180, 0, 0.08, 80));
                    Some(v)
                }
                8 => Some(render_tone(300, 30, 0, 0.03, 0)),
                _ => None,
            };
            if let Some(v) = msg {
                let _ = tx.send(v);
            }
        }
    });
}
#endrust
