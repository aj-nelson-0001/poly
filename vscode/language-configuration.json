{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern":
        "^(\\s*)((if|for|while|match|fn|struct|enum|impl|trait|macro|module) .*|loop.*|else( if .*)?|end fn)$",
    "decreaseIndentPattern": "^(\\s*)(end (if|for|while|loop|match|fn|struct|enum|impl|trait|macro|module)|else( if .*)?)$"
  }
}
