{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Poly",
  "scopeName": "source.poly",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#io_commands" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.poly",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.poly",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.poly" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.poly" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.poly",
              "match": "\\\\(n|r|t|0|\\\"|\\\\|u\\{[0-9a-fA-F]+\\})"
            },
            {
              "name": "meta.interpolation.poly",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.interpolation.begin.poly" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.interpolation.end.poly" }
              },
              "patterns": [
                {
                  "name": "variable.other.poly",
                  "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
                },
                {
                  "name": "constant.numeric.integer.poly",
                  "match": "\\b[0-9][0-9_]*\\b"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.poly",
          "begin": "unicode\\s+\\\"",
          "end": "\\\"",
          "beginCaptures": {
            "0": { "name": "keyword.other.unicode.poly" }
          },
          "patterns": [
            {
              "name": "meta.interpolation.poly",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.interpolation.begin.poly" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.interpolation.end.poly" }
              },
              "patterns": [
                {
                  "name": "variable.other.poly",
                  "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
                },
                {
                  "name": "constant.numeric.integer.poly",
                  "match": "\\b[0-9][0-9_]*\\b"
                }
              ]
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.poly",
          "match": "'([^'\\\\]|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.poly",
          "match": "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*)\\b"
        },
        {
          "name": "constant.numeric.float.poly",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(e[+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.poly",
          "match": "\\b[0-9][0-9_]*e[+-]?[0-9]+\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.poly",
          "begin": "\\b(async\\s+)?fn\\b",
          "end": "(?=\\bend\\s+fn\\b)",
          "beginCaptures": {
            "0": { "name": "keyword.other.fn.poly" }
          },
          "patterns": [
            {
              "name": "entity.name.function.poly",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*"
            },
            { "include": "#comments" }
          ]
        },
        {
          "name": "meta.struct.poly",
          "begin": "\\bstruct\\b",
          "end": "(?=\\bend\\s+struct\\b)",
          "beginCaptures": {
            "0": { "name": "keyword.other.struct.poly" }
          },
          "patterns": [
            {
              "name": "entity.name.type.poly",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            { "include": "#comments" }
          ]
        },
        {
          "name": "meta.enum.poly",
          "begin": "\\benum\\b",
          "end": "(?=\\bend\\s+enum\\b)",
          "beginCaptures": {
            "0": { "name": "keyword.other.enum.poly" }
          },
          "patterns": [
            {
              "name": "entity.name.type.poly",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            { "include": "#comments" }
          ]
        },
        {
          "name": "meta.trait.poly",
          "begin": "\\btrait\\b",
          "end": "(?=\\bend\\s+trait\\b)",
          "beginCaptures": {
            "0": { "name": "keyword.other.trait.poly" }
          },
          "patterns": [
            {
              "name": "entity.name.type.poly",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            { "include": "#comments" }
          ]
        },
        {
          "name": "meta.impl.poly",
          "begin": "\\bimpl\\b",
          "end": "(?=\\bend\\s+impl\\b)",
          "beginCaptures": {
            "0": { "name": "keyword.other.impl.poly" }
          },
          "patterns": [
            {
              "name": "entity.name.type.poly",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            { "include": "#comments" }
          ]
        },
        {
          "name": "meta.variable.poly",
          "begin": "\\b(var|let|const)\\b",
          "end": "(?=:|=|:=|\\s*$)",
          "beginCaptures": {
            "0": { "name": "keyword.other.var.poly" }
          },
          "patterns": [
            {
              "name": "entity.name.type.poly",
              "match": "\\b(u?string|i[0-9]+|u[0-9]+|f[0-9]+|isize|usize|bool|bytes|char)\\b"
            },
            {
              "name": "variable.other.poly",
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.poly",
          "match": "\\b(if|else|then|while|loop|for|in|match|break|continue|return|not|step)\\b"
        },
        {
          "name": "keyword.other.poly",
          "match": "\\b(end|set|to|add|sub|inc|dec|as|where|unsafe|async|await|spawn|move|type|macro|try|panic|null|addr|deref|capture|use|pub|module|with|validate|complete|encoding|timeout|default|mask|bytes)\\b"
        },
        {
          "name": "keyword.control.poly",
          "match": "\\b(end\\s+(if|for|while|loop|match|fn|struct|enum|trait|impl|macro|module))\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.poly",
          "match": "\\b(bool|i8|u8|i16|u16|i32|u32|i64|u64|f32|f64|isize|usize|string|ustring|bytes|char|void|Result|Option)\\b"
        },
        {
          "name": "entity.name.type.poly",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "io_commands": {
      "patterns": [
        {
          "name": "keyword.other.io.poly",
          "match": "\\b(put|get|error|warn|info)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.poly",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.poly",
          "match": "!=|<=|>=|<|>|=\\b"
        },
        {
          "name": "keyword.operator.arithmetic.poly",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "keyword.operator.word.poly",
          "match": "\\b(and|or|xor|mod|bitand|bitor|bitnot|shift\\s+(?:left|right))\\b"
        },
        {
          "name": "keyword.operator.bitwise.poly",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.pipe.poly",
          "match": "->|\\|>|<\\||\\.\\."
        }
      ]
    }
  }
}
